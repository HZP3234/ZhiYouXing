<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.travel.dao.TravelGuideCommentDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.travel.entity.TravelGuideCommentEntity" id="travelGuideCommentMap">
        <result property="refId" column="ref_id"/>
        <result property="userId" column="user_id"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="nickname" column="nickname"/>
        <result property="content" column="content"/>
        <result property="reply" column="reply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.travel.entity.vo.TravelGuideCommentVO" >
		SELECT * FROM travel_guide_comment  travel_guide_comment         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.travel.entity.vo.TravelGuideCommentVO" >
		SELECT  travel_guide_comment.* FROM travel_guide_comment  travel_guide_comment 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.travel.entity.view.TravelGuideCommentView" >

		SELECT  travel_guide_comment.* FROM travel_guide_comment  travel_guide_comment 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.travel.entity.view.TravelGuideCommentView" >
		SELECT * FROM travel_guide_comment  travel_guide_comment ${ew.customSqlSegment}
	</select>
	


</mapper>
