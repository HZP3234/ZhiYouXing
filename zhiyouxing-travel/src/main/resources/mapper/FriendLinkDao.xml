<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.travel.dao.FriendLinkDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.travel.entity.FriendLinkEntity" id="friendLinkMap">
        <result property="name" column="name"/>
        <result property="picture" column="picture"/>
        <result property="url" column="url"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.travel.entity.vo.FriendLinkVO" >
		SELECT * FROM friend_link  friend_link         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.travel.entity.vo.FriendLinkVO" >
		SELECT  friend_link.* FROM friend_link  friend_link 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.travel.entity.view.FriendLinkView" >

		SELECT  friend_link.* FROM friend_link  friend_link 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.travel.entity.view.FriendLinkView" >
		SELECT * FROM friend_link  friend_link ${ew.customSqlSegment}
	</select>
	


</mapper>
