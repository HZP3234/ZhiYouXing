<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.travel.dao.GroupTourDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.travel.entity.GroupTourEntity" id="groupTourMap">
        <result property="routeName" column="route_name"/>
        <result property="routeImage" column="route_image"/>
        <result property="departureDate" column="departure_date"/>
        <result property="routeFee" column="route_fee"/>
        <result property="signupCount" column="signup_count"/>
        <result property="groupTourAmount" column="group_tour_amount"/>
        <result property="guideNo" column="guide_no"/>
        <result property="userAccount" column="user_account"/>
        <result property="userName" column="user_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="groupTourTime" column="group_tour_time"/>
        <result property="isPay" column="is_pay"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.travel.entity.vo.GroupTourVO" >
		SELECT * FROM group_tour  group_tour         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.travel.entity.vo.GroupTourVO" >
		SELECT  group_tour.* FROM group_tour  group_tour 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.travel.entity.view.GroupTourView" >

		SELECT  group_tour.* FROM group_tour  group_tour 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.travel.entity.view.GroupTourView" >
		SELECT * FROM group_tour  group_tour ${ew.customSqlSegment}
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM group_tour
        ${ew.customSqlSegment}
        group by ${params.xColumn}
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM group_tour
                ${ew.customSqlSegment}
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM group_tour
                ${ew.customSqlSegment}
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM group_tour
                ${ew.customSqlSegment}
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM group_tour
        ${ew.customSqlSegment}
        group by ${params.column}
    </select>




</mapper>
