<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.travel.dao.NewsTypeDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.travel.entity.NewsTypeEntity" id="newsTypeMap">
        <result property="typeName" column="type_name"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.travel.entity.vo.NewsTypeVO" >
		SELECT * FROM news_type  news_type         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.travel.entity.vo.NewsTypeVO" >
		SELECT  news_type.* FROM news_type  news_type 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.travel.entity.view.NewsTypeView" >

		SELECT  news_type.* FROM news_type  news_type 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.travel.entity.view.NewsTypeView" >
		SELECT * FROM news_type  news_type ${ew.customSqlSegment}
	</select>
	


</mapper>
