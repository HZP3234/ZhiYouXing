<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.travel.dao.TravelRouteCommentDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.travel.entity.TravelRouteCommentEntity" id="travelRouteCommentMap">
        <result property="refId" column="ref_id"/>
        <result property="userId" column="user_id"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="nickname" column="nickname"/>
        <result property="content" column="content"/>
        <result property="reply" column="reply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.travel.entity.vo.TravelRouteCommentVO" >
		SELECT * FROM travel_route_comment  travel_route_comment         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.travel.entity.vo.TravelRouteCommentVO" >
		SELECT  travel_route_comment.* FROM travel_route_comment  travel_route_comment 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.travel.entity.view.TravelRouteCommentView" >

		SELECT  travel_route_comment.* FROM travel_route_comment  travel_route_comment 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.travel.entity.view.TravelRouteCommentView" >
		SELECT * FROM travel_route_comment  travel_route_comment ${ew.customSqlSegment}
	</select>
	


</mapper>
