<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.travel.dao.TourGuideDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.travel.entity.TourGuideEntity" id="tourGuideMap">
        <result property="guideNo" column="guide_no"/>
        <result property="password" column="password"/>
        <result property="guideName" column="guide_name"/>
        <result property="avatar" column="avatar"/>
        <result property="specialty" column="specialty"/>
        <result property="languageSkill" column="language_skill"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="guideResume" column="guide_resume"/>
        <result property="status" column="status"/>
        <result property="passwordWrongNum" column="password_wrong_num"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.travel.entity.vo.TourGuideVO" >
		SELECT * FROM tour_guide  tour_guide         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.travel.entity.vo.TourGuideVO" >
		SELECT  tour_guide.* FROM tour_guide  tour_guide 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.travel.entity.view.TourGuideView" >

		SELECT  tour_guide.* FROM tour_guide  tour_guide 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.travel.entity.view.TourGuideView" >
		SELECT * FROM tour_guide  tour_guide ${ew.customSqlSegment}
	</select>
	


</mapper>
