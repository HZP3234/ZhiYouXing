<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.attraction.dao.AttractionTypeDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.attraction.entity.AttractionTypeEntity" id="attractionTypeMap">
        <result property="attractionType" column="attraction_type"/>
        <result property="image" column="image"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.attraction.entity.vo.AttractionTypeVO" >
		SELECT * FROM attraction_type  attraction_type         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.attraction.entity.vo.AttractionTypeVO" >
		SELECT  attraction_type.* FROM attraction_type  attraction_type 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.attraction.entity.view.AttractionTypeView" >

		SELECT  attraction_type.* FROM attraction_type  attraction_type 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.attraction.entity.view.AttractionTypeView" >
		SELECT * FROM attraction_type  attraction_type ${ew.customSqlSegment}
	</select>
	


</mapper>
