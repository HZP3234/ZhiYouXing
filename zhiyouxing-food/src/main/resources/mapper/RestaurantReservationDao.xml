<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.food.dao.RestaurantReservationDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.food.entity.RestaurantReservationEntity" id="restaurantReservationMap">
        <result property="restaurantName" column="restaurant_name"/>
        <result property="restaurantImage" column="restaurant_image"/>
        <result property="restaurantType" column="restaurant_type"/>
        <result property="dinerCount" column="diner_count"/>
        <result property="reservationTime" column="reservation_time"/>
        <result property="diningRemark" column="dining_remark"/>
        <result property="userAccount" column="user_account"/>
        <result property="userName" column="user_name"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="auditStatus" column="audit_status"/>
        <result property="auditReply" column="audit_reply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.food.entity.vo.RestaurantReservationVO" >
		SELECT * FROM restaurant_reservation  restaurant_reservation         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.food.entity.vo.RestaurantReservationVO" >
		SELECT  restaurant_reservation.* FROM restaurant_reservation  restaurant_reservation 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.food.entity.view.RestaurantReservationView" >

		SELECT  restaurant_reservation.* FROM restaurant_reservation  restaurant_reservation 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.food.entity.view.RestaurantReservationView" >
		SELECT * FROM restaurant_reservation  restaurant_reservation ${ew.customSqlSegment}
	</select>
	

    <select id="selectValue" resultType="map" >
        SELECT ${params.xColumn}, ROUND(sum(${params.yColumn}),1) total FROM restaurant_reservation
        ${ew.customSqlSegment}
        group by ${params.xColumn}
    </select>

    <select id="selectTimeStatValue" resultType="map" >
        <if test = 'params.timeStatType == "日"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m-%d') ${params.xColumn}, sum(${params.yColumn}) total FROM restaurant_reservation
                ${ew.customSqlSegment}
                group by DATE_FORMAT(${params.xColumn},'%Y-%m-%d')
        </if>
        <if test = 'params.timeStatType == "月"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y-%m') ${params.xColumn}, sum(${params.yColumn}) total FROM restaurant_reservation
                ${ew.customSqlSegment}
                group by DATE_FORMAT(${params.xColumn},'%Y-%m')
        </if>
        <if test = 'params.timeStatType == "年"'>
                SELECT DATE_FORMAT(${params.xColumn},'%Y') ${params.xColumn}, sum(${params.yColumn}) total FROM restaurant_reservation
                ${ew.customSqlSegment}
                group by DATE_FORMAT(${params.xColumn},'%Y')
        </if>
    </select>

    <select id="selectGroup" resultType="map" >
        SELECT ${params.column} , count(1) total FROM restaurant_reservation
        ${ew.customSqlSegment}
        group by ${params.column}
    </select>




</mapper>
