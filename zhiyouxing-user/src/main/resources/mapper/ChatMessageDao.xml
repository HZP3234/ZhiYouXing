<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.user.dao.ChatMessageDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.user.entity.ChatMessageEntity" id="chatMessageMap">
        <result property="uid" column="uid"/>
        <result property="fid" column="fid"/>
        <result property="content" column="content"/>
        <result property="format" column="format"/>
        <result property="isRead" column="is_read"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.user.entity.vo.ChatMessageVO" >
		SELECT * FROM chat_message  chat_message         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.user.entity.vo.ChatMessageVO" >
		SELECT  chat_message.* FROM chat_message  chat_message 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.user.entity.view.ChatMessageView" >

		SELECT  chat_message.* FROM chat_message  chat_message 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.user.entity.view.ChatMessageView" >
		SELECT * FROM chat_message  chat_message ${ew.customSqlSegment}
	</select>
	


</mapper>
