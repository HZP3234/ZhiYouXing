<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zhiyouxing.hotel.dao.HotelCommentDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.zhiyouxing.hotel.entity.HotelCommentEntity" id="hotelCommentMap">
        <result property="refId" column="ref_id"/>
        <result property="userId" column="user_id"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="nickname" column="nickname"/>
        <result property="content" column="content"/>
        <result property="score" column="score"/>
        <result property="reply" column="reply"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.zhiyouxing.hotel.entity.vo.HotelCommentVO" >
		SELECT * FROM hotel_comment  hotel_comment         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.zhiyouxing.hotel.entity.vo.HotelCommentVO" >
		SELECT  hotel_comment.* FROM hotel_comment  hotel_comment 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.zhiyouxing.hotel.entity.view.HotelCommentView" >

		SELECT  hotel_comment.* FROM hotel_comment  hotel_comment 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.zhiyouxing.hotel.entity.view.HotelCommentView" >
		SELECT * FROM hotel_comment  hotel_comment ${ew.customSqlSegment}
	</select>
	


</mapper>
